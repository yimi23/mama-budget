# deploy/.env: the API's environment on the box. Same keys as api/.env.example, plus MAMA_DOMAIN for Caddy.
# Never commit the filled file (deploy/.env is ignored).
MAMA_DOMAIN=api.mamabudget.com
# The ChatGPT app (apps/chatgpt). Paste https://MAMA_CHATGPT_DOMAIN/mcp into ChatGPT > Apps and connectors > Add custom MCP server.
MAMA_CHATGPT_DOMAIN=chatgpt.mamabudget.com

# Model and voice
ANTHROPIC_API_KEY=
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=
ELEVEN_VOICE_ID_NANA=
ELEVEN_VOICE_ID_ABUELA=
ELEVEN_VOICE_ID_WONG=

# Texts (Photon Spectrum). The Mac iMessage kit does not exist on a Linux box; Spectrum carries every text here.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
PHOTON_TO=
PHOTON_DAILY_CAP=0
PHOTON_GAP_MS=15000

# Bank. The owner's SimpleFIN link; other users link through the popup and are stored encrypted in the database.
SIMPLEFIN_ACCESS_URL=
# Demo bank fallback for people without a link.
NESSIE_KEY=
NESSIE_BASE=https://api.nessieisreal.com

# Billing (docs/research/PRICING.md). Unset = open, nobody gated. Webhook endpoint: https://MAMA_DOMAIN/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTH=
STRIPE_PRICE_YEAR=
MAMA_PUBLIC_URL=https://api.mamabudget.com
MAMA_FREE_TIER=

# deploy/aws-launch.sh writes this file from api/.env and adds the box-only keys below.
# Encrypts bank links at rest. Any long random string; losing it means users relink their banks.
MAMA_SERVER_KEY=
