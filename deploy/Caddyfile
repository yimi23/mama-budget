# api.mamabudget.com -> the API container. Caddy fetches the certificate from Let's Encrypt and renews it.
{$MAMA_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:8787
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
	log {
		output stdout
		format console
	}
}
