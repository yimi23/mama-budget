# copy to .env and fill in. Everything is optional: with nothing set, the demo runs on local cache and text lines.
PORT=8787
FUN_BUDGET=75
USD_NGN=1600

# Capital One Nessie (free key from the Nessie developer site)
NESSIE_KEY=
NESSIE_BASE=https://api.nessieisreal.com

# ElevenLabs
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=

# Optional model for her lines. Without it the fixed line bank is used.
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-4-5

# Photon cloud iMessage (spectrum-ts, see api/photon/spectrum.js). No Mac needed. Sign up and create a
# project at https://app.photon.codes/ -- its Settings page has these two. Unset: the "log" sender is
# used instead (GET /messages shows what she would have texted).
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# The number she texts first (before anyone has texted in) and the weekly/monthly statements go to.
PHOTON_TO=
