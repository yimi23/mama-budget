# copy to .env and fill in. Everything is optional: with nothing set, the demo runs on local cache and text lines.
PORT=8787
FUN_BUDGET=75
USD_NGN=1600

# Capital One Nessie (free key from the Nessie developer site)
NESSIE_KEY=
NESSIE_BASE=https://api.nessieisreal.com
# The bank, read only. Claimed once from a Setup Token (api/budget/sync.js claim); looks like https://user:pass@beta-bridge.simplefin.org/simplefin
SIMPLEFIN_ACCESS_URL=

# ElevenLabs
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=
# The other grandmas' voices (ELEVEN_VOICE_ID_<WHO>). Unset, she borrows Mama's.
ELEVEN_VOICE_ID_NANA=
ELEVEN_VOICE_ID_ABUELA=
ELEVEN_VOICE_ID_WONG=

# Optional model: reads carts she has never seen, classifies unknown items, reads typed reasons, writes her lines.
# Without it the fixed line bank and the word lists are used. Her promises hold either way.
ANTHROPIC_API_KEY=
MODEL=claude-opus-5-5

# Photon cloud iMessage (spectrum-ts, see api/photon/spectrum.js). No Mac needed. Sign up and create a
# project at https://app.photon.codes/ -- its Settings page has these two. Unset: the "log" sender is
# used instead (GET /messages shows what she would have texted).
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# The number she texts first (before anyone has texted in) and the weekly/monthly statements go to.
# On a Mac signed into Messages this alone turns on the Mac kit sender (api/photon/kit.js): no signup, no
# Spectrum. Unset, she never texts anyone and the UI says "Texts are off right now". See docs/PHOTON.md.
PHOTON_TO=
# Who she answers when they text the Mac. Default: PHOTON_TO only. Comma list, or * for anyone.
PHOTON_ALLOW=
# Unprompted texts a day per person (statements and replies do not count). 0 turns the cap off for rehearsals.
PHOTON_DAILY_CAP=1
# Minimum gap between unprompted texts to one person, in ms.
PHOTON_GAP_MS=180000
# PHOTON_DRY=1 rehearses on the Mac kit: everything decided and logged, Messages never touched.
PHOTON_DRY=
# Quiet hours for her own texts (11pm to 7am), opt in for the hackathon.
PHOTON_QUIET=
# A photo and its caption within this window are one turn (ms).
PHOTON_DEBOUNCE_MS=5000
# Model budgets in ms, all optional: MODEL_CLASSIFY_WAIT_MS=3500 MODEL_CHEAPER_TIMEOUT_MS=20000 MODEL_FRESH_TIMEOUT_MS=1800
