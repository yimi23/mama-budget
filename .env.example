# copy to .env and fill in. Everything is optional: with nothing set, the demo runs on local cache and text lines.
PORT=8787
FUN_BUDGET=75
USD_NGN=1600

# Capital One Nessie (free key from the Nessie developer site)
NESSIE_KEY=
NESSIE_BASE=https://api.nessieisreal.com

# ElevenLabs
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=

# Optional model for her lines. Without it the fixed line bank is used.
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-4-5

# Photon (only on the Mac that runs Messages)
PHOTON_TO=
