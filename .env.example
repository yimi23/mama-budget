# copy to .env and fill in. Everything is optional: with nothing set, the demo runs on local cache and text lines.
PORT=8787
FUN_BUDGET=75
USD_NGN=1600

# Capital One Nessie (free key from the Nessie developer site)
NESSIE_KEY=
NESSIE_BASE=https://api.nessieisreal.com

# ElevenLabs
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=

# Optional model for her lines. Without it the fixed line bank is used.
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-4-5

# Photon iMessage kit (only on the Mac that runs Messages, see docs/PHOTON.md)
# The number or email she texts: the judge's iPhone during the demo. Unset: she never texts and the UI says so.
PHOTON_TO=
# Who she answers when they text her. Default: PHOTON_TO only. Comma list, or * for anyone.
PHOTON_ALLOW=
# Unprompted texts a day per person (statements and replies do not count). 0 turns the cap off for rehearsals.
PHOTON_DAILY_CAP=1
# Minimum gap between unprompted texts to one person, in ms.
PHOTON_GAP_MS=180000
